# Docker Compose reads this file after copying it to .env.
CORS_ORIGINS=http://localhost:3000
MAX_FILE_MB=20
MAX_REQUEST_MB=64
MAX_FILES=20
MAX_PAGES=100
MAX_IMAGE_PIXELS=25000000
MAX_CONCURRENT_JOBS=2
REQUESTS_PER_MINUTE=20
PROCESSING_TIMEOUT_SECONDS=180
TEMP_RETENTION_SECONDS=900
# Local frontend: put these in frontend/.env.local when changing defaults.
# API_INTERNAL_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional local backend paths (export before starting uvicorn):
# LIBREOFFICE_BINARY=C:/Program Files/LibreOffice/program/soffice.exe
# TESSERACT_BINARY=C:/Program Files/Tesseract-OCR/tesseract.exe
# U2NET_HOME=/path/to/model-cache
MAX_RENDER_PIXELS=100000000
MAX_TEXT_CHARS=20000
